{
  "permissions": {
    "allow": [
      "Bash(python scripts/run_dev.py)",
      "Bash(python scripts/run_all_tests.py)",
      "Bash(python scripts/manage_cache.py*)",
      "Bash(cd services/quant-engine && pytest*)",
      "Bash(cd services/quant-engine && uvicorn*)",
      "Bash(cd apps/desktop && npm*)",
      "Bash(cd apps/desktop && npx*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/pre_commit_gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/schema_edit_reminder.py"
          }
        ]
      }
    ]
  }
}
